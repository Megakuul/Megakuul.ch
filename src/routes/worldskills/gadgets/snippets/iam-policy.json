{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateLambdaLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "*"
    },
    {
      "Sid": "WriteAndReadOwnDiagnostics",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents", "logs:FilterLogEvents"],
      "Resource": "arn:aws:logs:eu-central-1:111122223333:log-group:/aws/lambda/my-gadget:*"
    },
    {
      "Sid": "ConsumeAnalyzerQueues",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:eu-central-1:111122223333:my-analysis-queue"
    },
    {
      "Sid": "ConsumeAnalyzerStreams",
      "Effect": "Allow",
      "Action": [
        "kinesis:DescribeStream",
        "kinesis:DescribeStreamSummary",
        "kinesis:GetRecords",
        "kinesis:GetShardIterator",
        "kinesis:ListShards"
      ],
      "Resource": "arn:aws:kinesis:eu-central-1:111122223333:stream/my-analysis-stream"
    }
  ]
}
