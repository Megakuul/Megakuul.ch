{
  "name": "ecr-image-builder",
  "description": "Build and push images from the ECR manager",
  "source": {
    "type": "GITHUB",
    "location": "https://github.com/REPLACE_OWNER/REPLACE_REPOSITORY.git",
    "gitCloneDepth": 1,
    "buildspec": "ecr-buildspec.yml"
  },
  "artifacts": {
    "type": "NO_ARTIFACTS"
  },
  "environment": {
    "type": "LINUX_CONTAINER",
    "computeType": "BUILD_GENERAL1_SMALL",
    "image": "aws/codebuild/standard:7.0",
    "imagePullCredentialsType": "CODEBUILD",
    "privilegedMode": true,
    "environmentVariables": [
      {
        "name": "ECR_REPOSITORY",
        "value": "app",
        "type": "PLAINTEXT"
      },
      {
        "name": "IMAGE_TAG",
        "value": "latest",
        "type": "PLAINTEXT"
      },
      {
        "name": "DOCKERFILE",
        "value": "Dockerfile",
        "type": "PLAINTEXT"
      },
      {
        "name": "BUILD_CONTEXT",
        "value": ".",
        "type": "PLAINTEXT"
      }
    ]
  },
  "serviceRole": "arn:aws:iam::111122223333:role/ecr-image-builder",
  "timeoutInMinutes": 30,
  "queuedTimeoutInMinutes": 60,
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/aws/codebuild/ecr-image-builder",
      "streamName": "build"
    }
  }
}
